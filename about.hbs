LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
SUCH DAMAGE.</pre></li>
                </ul>
            </li>
            <li class="license">
                <h3>sqlite-remote-vfs 0.6.0 and sqlite-remote-protocol 0.6.0</h3>
                <p>
                    The browser target's storage VFS (ADR-0035), a git dependency of
                    <code>kupferdraht-core</code> pinned by revision. The crates are
                    marked <code>publish = false</code>, so cargo-about treats them as
                    private and leaves them out. Apache License 2.0, Schwarz Digits,
                    <a href="https://github.com/SchwarzDigits/sqlite-remote-vfs">github.com/SchwarzDigits/sqlite-remote-vfs</a>.
                </p>
            </li>
        </ul>

        <h2>All license text:</h2>
        <ul class="licenses-list">
            {{#each licenses}}
            <li class="license">
                <h3 id="{{id}}">{{name}}</h3>
                <h4>Used by:</h4>
                <ul class="license-used-by">
                    {{#each used_by}}
                    <li><a href="{{#if crate.repository}} {{crate.repository}} {{else}} https://crates.io/crates/{{crate.name}} {{/if}}">{{crate.name}} {{crate.version}}</a></li>
                    {{/each}}
                </ul>
                <pre class="license-text">{{text}}</pre>
            </li>
            {{/each}}
        </ul>
    </main>
</body>

</html>
