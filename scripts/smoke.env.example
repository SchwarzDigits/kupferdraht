# Local smoke environment — template.
#
# Copy to scripts/smoke.env (git-ignored) and fill in. smoke.env holds
# the self-hosted instance URL and test-user credentials; neither may
# ever be committed. `source` it in the shell that runs the manual smoke
# procedures of docs/cli.md and scripts/smoke-baseline.sh.
#
# Two users are enough for the full receive-path matrix: device A
# holds the stream, device B sends. Separate KUPFERDRAHT_HOME dirs keep the
# two devices' local state (kupferdraht.db, mls.db) apart on one machine.
# A third user is optional but needed for first-contact scenarios:
# Wire's deterministic 1:1 stays established forever, so a fresh-DM
# flow (Step 68 establish branch, Step 69 Welcome-on-first-sync) can
# only run against a pair that has never DM'd before.

export KUPFERDRAHT_SMOKE_API_URL="https://nginz-https.<your-instance-domain>"
# WebSocket URL derives via the nginz convention (backend.rs);
# uncomment only if your deployment routes the socket differently:
#export KUPFERDRAHT_SMOKE_WS_URL="wss://nginz-ssl.<your-instance-domain>"

export KUPFERDRAHT_SMOKE_EMAIL_1="<user-1-email>"
export KUPFERDRAHT_SMOKE_PASSWORD_1="<user-1-password>"
export KUPFERDRAHT_SMOKE_USER_1="<user-1-uuid>@<your-instance-domain>"

export KUPFERDRAHT_SMOKE_EMAIL_2="<user-2-email>"
export KUPFERDRAHT_SMOKE_PASSWORD_2="<user-2-password>"
export KUPFERDRAHT_SMOKE_USER_2="<user-2-uuid>@<your-instance-domain>"

#export KUPFERDRAHT_SMOKE_EMAIL_3="<user-3-email>"
#export KUPFERDRAHT_SMOKE_PASSWORD_3="<user-3-password>"
#export KUPFERDRAHT_SMOKE_USER_3="<user-3-uuid>@<your-instance-domain>"

export KUPFERDRAHT_SMOKE_HOME_1="$HOME/.kupferdraht-smoke-1"
export KUPFERDRAHT_SMOKE_HOME_2="$HOME/.kupferdraht-smoke-2"

# NOTE: every fresh-home smoke run registers new devices; Wire caps
# devices per account (~8). Clean up periodically:
#   kupferdraht-cli login ... --delete-device <id>   # frees a slot
#   kupferdraht-cli device-delete --id <id> --password-stdin
#
# Dev keystore dir (NG-15): avoids the macOS keychain re-prompt per
# fresh build during smoke runs.
export KUPFERDRAHT_DEV_KEYSTORE="$HOME/.kupferdraht-smoke-keystore"
